# ============================================
# Firebase Client SDK (from Firebase Console → Project Settings → Web App)
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=taskmanager-octo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================
# Firebase Admin SDK (from Service Account JSON)
# Obtenha em: Google Cloud Console → IAM → Service Accounts → Chaves → Criar nova chave (JSON)
# ============================================
# Campo "client_email" do JSON da Service Account
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@taskmanager-octo.iam.gserviceaccount.com

# Campo "private_key" do JSON da Service Account
# IMPORTANTE no Vercel: Cole a chave INTEIRA (incluindo -----BEGIN/END-----) como uma única string.
# O código já faz o replace de \n para quebras de linha reais.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# ============================================
# Telegram Integration
# ============================================
# Token do bot obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# ============================================
# Cron Configuration
# ============================================
# Secret para proteger a rota /api/cron/daily-summary de acessos não autorizados
CRON_SECRET=
